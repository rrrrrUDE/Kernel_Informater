menuconfig KI
	bool "Kernel Informater"
	default n
	help
	  Kernel Informater provides kernel information management,
	  runtime control, userspace communication and hook interfaces.

if KI

config KI_DEBUG
	bool "Kernel Informater debug"
	default n
	help
	  Enable kernel-side debug logging for Kernel Informater.

config KI_BOOTAPPLY
	bool "Kernel Informater boot apply"
	default n
	help
	  Apply persistent configuration from /data/adb/ki_user/config at boot.
	  The configuration remains applied in kernel memory while active; this
	  does not perform periodic config file reads. Userspace config changes
	  explicitly synchronize the kernel configuration.

config KI_TRACEPOINT_HOOK
	bool "Tracepoint Syscall Redirect as GKI Hook"
	default n # KI_TRACEPOINT_HOOK_DEFAULT
	depends on ARM64
	depends on ANDROID
	depends on TRACEPOINTS
	depends on HAVE_SYSCALL_TRACEPOINTS
		help
	  Enable the Tracepoint Syscall Redirect hook for Android GKI 2.0 kernels.

	  This automatic backend is intended for Android GKI 2.0+ (5.10+) and
	  uses the kernel syscall tracepoint interface together with Android
	  vendor trace hooks. It has no probe-based fallback path.

	  Android GKI 1.0, non-GKI kernels, and kernels at 5.4 or older must
	  keep this option disabled and use integrate.sh for source-level
	  manual hooks.

endif
