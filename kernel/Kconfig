menuconfig KI
	bool "Kernel Informater"
	default n
	help
	  Kernel Informater provides kernel information management,
	  runtime control, userspace communication and hook interfaces.

if KI

config KI_DEBUG
	bool "Kernel Informater debug"
	default n
	help
	  Enable kernel-side debug logging for Kernel Informater.

config KI_BOOTAPPLY
	bool "Kernel Informater boot apply"
	default n
	help
	  Apply persistent configuration from /data/adb/ki_user/config at boot.
	  The configuration remains applied in kernel memory while active; this
	  does not perform periodic config file reads. Userspace config changes
	  explicitly synchronize the kernel configuration.

config KI_KPROBEHOOK
	bool "Kernel Informater automatic GKI trace hook"
	default n # KI_AUTO_HOOK_DEFAULT
	depends on ARM64
	depends on ANDROID
	depends on ANDROID_VENDOR_HOOKS
	help
	  Enable the automatic Android GKI vendor-hook backend.

	  This mode is for Android GKI kernels that provide the Android vendor
	  hook framework (5.10+). It uses GKI trace hooks only; it does not use
	  kprobes as a fallback.

	  For legacy Android/non-GKI kernels such as 5.4 and older, keep this
	  disabled and use integrate.sh for source-level manual hooks.

endif
